# Optional GitHub target override when the active checkout is this framework.
OPENCODE_GITHUB_REPO=owner/repository
OPENCODE_GITHUB_PROJECT=
OPENCODE_GITHUB_PROJECT_OWNER=owner

# Optional external repository and worktree locations.
OPENCODE_REPO_ROOT=./repositories
OPENCODE_WORKTREE_ROOT=./.worktrees

# Optional remote cluster configuration. SSH keys or an SSH agent are preferred.
OPENCODE_CLUSTER_USER=user
OPENCODE_CLUSTER_HOST=host.example
OPENCODE_CLUSTER_ROOT=/path/to/project
OPENCODE_CLUSTER_VENV=
OPENCODE_CLUSTER_SCREEN=
# Optional Windows Credential Manager generic-credential target. Store the
# username and secret in Credential Manager; never put the secret in this file.
# When set, cluster_credentials.py uses plink/pscp by default.
OPENCODE_CLUSTER_CREDENTIAL_TARGET=
OPENCODE_CLUSTER_SSH_CLIENT=
OPENCODE_CLUSTER_SCP_CLIENT=
# Backward-compatible SSH client command override.
OPENCODE_CLUSTER_SSH_COMMAND=
